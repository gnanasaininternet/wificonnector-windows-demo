{
  "name": "wificonnector-windows-demo",
  "version": "1.0.0",
  "description": "WiFi Connector Windows Demo (WPA2-Enterprise)",
  "main": "main.js",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },

  "build": {
    "appId": "com.wificonnector.demo",
    "productName": "WifiConnector",

    "files": [
      "**/*",
      "wifi_profile.xml"
    ],

    "extraResources": [
      {
        "from": "wifi_profile.xml",
        "to": "wifi_profile.xml"
      }
    ],

    "win": {
      "target": "nsis"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  },

  "dependencies": {
    "axios": "^1.6.0"
  },

  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^26.0.12"
  }
}
